-- Table name: Batches (from inventory_batches_query.m)
Total Stock Value = SUM(Batches[Stock_Value_INR])
At-Risk Value = SUM(Batches[Excess_Value_INR])
At-Risk % = DIVIDE([At-Risk Value], [Total Stock Value], 0)
Batch Count = COUNTROWS(Batches)
Expired Batches = CALCULATE([Batch Count], Batches[Risk_Band] = "Expired")
Expired Value = CALCULATE([Total Stock Value], Batches[Risk_Band] = "Expired")
Critical Batches = CALCULATE([Batch Count], Batches[Risk_Band] = "Critical")
Critical At-Risk Value = CALCULATE([At-Risk Value], Batches[Risk_Band] = "Critical")
Zero Demand Value = CALCULATE([Total Stock Value], Batches[Risk_Band] = "Zero Demand")
Avg Days of Cover = AVERAGEX(FILTER(Batches, NOT ISBLANK(Batches[Days_Of_Cover])), Batches[Days_Of_Cover])
Median Days To Expiry (Critical) = CALCULATE(MEDIAN(Batches[Days_To_Expiry]), Batches[Risk_Band] = "Critical")
-- Transfer flag (add as calculated column in Power BI; needs destination capacity)
Dest Absorb Capacity = MAX(0, DIVIDE(Batches[Destination_Sales_Qty_30D], 30) * MAX(Batches[Days_To_Expiry], 0) - Batches[Destination_On_Hand_Qty])
